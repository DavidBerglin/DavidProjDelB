</svg>

@if (Model.Friend != null)
{
    <div class="container px-4 py-5">
        <div class="text-center mb-5">
            <h1 class="display-5 fw-bold text-primary mb-3">
                <svg class="bi bi-person-fill" width="50" height="50">
                    <use xlink:href="#person-fill" />
                </svg>
                Friend Details
            </h1>
            <p class="lead text-muted">Complete information about @Model.Friend.FirstName @Model.Friend.LastName</p>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header py-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <h4 class="mb-0 fw-bold text-white">
                    <svg class="bi bi-person-fill" width="1.5em" height="1.5em" fill="white">
                        <use xlink:href="#person-fill" />
                    </svg>
                    Personal Information
                </h4>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label for="firstname" class="form-label fw-semibold">Firstname</label>
                        <input type="text" class="form-control bg-light" id="firstname" value="@Model.Friend.FirstName" readonly>
                    </div>
                    <div class="col-sm-6">
                        <label for="lastname" class="form-label fw-semibold">Lastname</label>
                        <input type="text" class="form-control bg-light" id="lastname" value="@Model.Friend.LastName" readonly>
                    </div>
                    <div class="col-sm-6">
                        <label for="friendBirthday" class="form-label fw-semibold">Birthday</label>
                        <input type="text" class="form-control bg-light" id="friendBirthday"
                            value="@(Model.Friend.Birthday.HasValue? Model.Friend.Birthday.Value.ToString("yyyy-MM-dd") : "Couldnt find any birthday")"
                            readonly>
                    </div>
                    <div class="col-sm-6">
                        <label for="friendEmail" class="form-label fw-semibold">Email</label>
                        <input type="text" class="form-control bg-light" id="friendEmail" value="@Model.Friend.Email" readonly>
                    </div>
                    <div class="col-sm-6">
                        <label for="friendID" class="form-label fw-semibold">Friend ID</label>
                        <input type="text" class="form-control bg-light" id="friendID" value="@Model.Friend.FriendId" readonly>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header py-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <h4 class="mb-0 fw-bold text-white">
                    <svg class="bi me-2" width="1.5em" height="1.5em" fill="white">
                        <use xlink:href="#home" />
                    </svg>
                    Address
                </h4>
            </div>
            <div class="card-body p-4">
                @if (!Model.EditAddress && Model.Friend.Address != null)
                {
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="Friend.Address.StreetAddress" class="form-label fw-semibold"></label>
                            <input asp-for="Friend.Address.StreetAddress" class="form-control bg-light" readonly>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Friend.Address.City" class="form-label fw-semibold"></label>
                            <input asp-for="Friend.Address.City" class="form-control bg-light" readonly>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Friend.Address.ZipCode" class="form-label fw-semibold"></label>
                            <input asp-for="Friend.Address.ZipCode" class="form-control bg-light" readonly>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Friend.Address.Country" class="form-label fw-semibold"></label>
                            <input asp-for="Friend.Address.Country" class="form-control bg-light" readonly>
                        </div>
                        <div class="col-sm-12">
                            <a asp-page="./FriendDetails" asp-route-id="@Model.Friend.FriendId" asp-route-edit="true"
                                class="btn btn-primary btn-sm mt-2">
                                <svg class="bi me-1" width="0.9em" height="0.9em" fill="white"><use xlink:href="#edit"/></svg>
                                Edit Address
                            </a>
                        </div>
                    </div>
                }
                @if (Model.EditAddress)
                {
                    <form method="post" asp-page-handler="Edit">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label asp-for="AddressIM.StreetAddress" class="form-label"></label>
                                <input asp-for="AddressIM.StreetAddress" class="form-control">
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="AddressIM.City" class="form-label"></label>
                                <input asp-for="AddressIM.City" class="form-control">
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="AddressIM.ZipCode" class="form-label"></label>
                                <input asp-for="AddressIM.ZipCode" class="form-control">
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="AddressIM.Country" class="form-label"></label>
                                <input asp-for="AddressIM.Country" class="form-control">
                            </div>
                            <input type="hidden" asp-for="AddressIM.AddressId" />
                            <input type="hidden" asp-for="AddressIM.FriendId" />
                            <div class="col-sm-12">
                                <button type="submit" class="btn btn-success btn-sm mt-2">
                                    <svg class="bi me-1" width="0.9em" height="0.9em" fill="white"><use xlink:href="#save"/></svg>
                                    Save Changes
                                </button>
                                <a class="btn btn-outline-secondary btn-sm ms-2 mt-2" asp-page="./FriendDetails"
                                    asp-route-id="@Model.Friend.FriendId">
                                    <svg class="bi me-1" width="0.9em" height="0.9em"><use xlink:href="#undo"/></svg>
                                    Cancel
                                </a>
                            </div>
                        </div>
                    </form>
                }
            </div>
        </div>

        @if (Model.Friend.Pets != null)
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header py-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h4 class="mb-0 fw-bold text-white">
                        <svg class="heart-fill" width="1.5em" height="1.5em" fill="white">
                            <use xlink:href="#heart-fill" />
                        </svg>
                        Pets
                    </h4>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">

                        @foreach (var pet in Model.Friend.Pets)
                        {
                            <div class="col-sm-6">
                                <label for="petName-@pet.PetId" class="form-label fw-semibold">Name</label>
                                <input type="text" class="form-control bg-light" id="petName-@pet.PetId" value="@pet.Name" readonly>
                            </div>

                            <div class="col-sm-6">
                                <label for="petKind-@pet.PetId" class="form-label fw-semibold">Kind</label>
                                <input type="text" class="form-control bg-light" id="petKind-@pet.PetId" value="@pet.Kind" readonly>
                            </div>

                            <div class="col-sm-12">
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="friendId" value="@Model.Friend.FriendId" />
                                    <input type="hidden" name="petId" value="@pet.PetId" />
                                    <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal"
                                        data-bs-target="#deleteModal@(pet.PetId)">
                                        <svg class="bi me-1" width="0.9em" height="0.9em" fill="white"><use xlink:href="#undo"/></svg>
                                        Delete Pet
                                    </button>

                                <div class="modal fade" id="deleteModal@(pet.PetId)" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title text-danger">Confirm deletion</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                You are about to delete @pet.Name. the @pet.Kind Are you sure?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                                                <button type="submit" asp-page-handler="Delete" class="btn btn-danger">Yes</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body text-center py-4">
                    <svg class="bi text-muted mb-3" width="3em" height="3em">
                        <use xlink:href="#boombox" />
                    </svg>
                    <p class="text-muted mb-0">This friend has no pets.</p>
                </div>
            </div>
        }
        @if (Model.Friend.Quotes != null)
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header py-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h4 class="mb-0 fw-bold text-white">
                        <svg class="bi bi-chat-fill" width="1.5em" height="1.5em" fill="white">
                            <use xlink:href="#chat-fill" />
                        </svg>
                        Favorite Quotes
                    </h4>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">

                        @foreach (var quote in Model.Friend.Quotes)
                        {
                            <div class="col-sm-6">
                                <label for="quoteText-@quote.QuoteId" class="form-label fw-semibold">Quote</label>
                                <input type="text" class="form-control bg-light" id="quoteText-@quote.QuoteId" value="@quote.QuoteText"
                                    readonly>
                            </div>

                            <div class="col-sm-6">
                                <label for="quoteAuthor-@quote.QuoteId" class="form-label fw-semibold">Author</label>
                                <input type="text" class="form-control bg-light" id="quoteAuthor-@quote.QuoteId" value="@quote.Author"
                                    readonly>
                            </div>

                            <div class="col-sm-12">
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="friendId" value="@Model.Friend.FriendId" />
                                    <input type="hidden" name="quoteId" value="@quote.QuoteId" />
                                    <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal"
                                        data-bs-target="#deleteModalQuote@(quote.QuoteId)">
                                        <svg class="bi me-1" width="0.9em" height="0.9em" fill="white"><use xlink:href="#undo"/></svg>
                                        Delete Quote
                                    </button>

                                <div class="modal fade" id="deleteModalQuote@(quote.QuoteId)" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title text-danger">Confirm deletion</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                You are about to delete a quote by @quote.Author. Are you sure?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                                                <button type="submit" asp-page-handler="Delete" class="btn btn-danger">Yes</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body text-center py-4">
                    <svg class="bi text-muted mb-3" width="3em" height="3em">
                        <use xlink:href="#artist" />
                    </svg>
                    <p class="text-muted mb-0">This friend has no quotes.</p>
                </div>
            </div>
        }
    </div>
}
else
{
    <h4>FRIEND NOT FOUND </h4>
}