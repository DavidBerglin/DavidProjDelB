@page
@using Models
@using System.Diagnostics.Eventing.Reader
@using myFirstRazorPage.Pages
@model FriendDetails
@{
    ViewData["Title"] = "Friend information";
    Layout = "_Layout";
}

@if (Model.Friend != null) {
<div class="row row-cols-1 row-cols-lg-4 align-items-stretch g-4 py-5">
    <h3 class="pb-2 border-bottom">Friend information</h3>

    <div class="col-md-7 col-lg-10">

        <div class="row g-3">
            <div class="col-sm-6">
                <label for="firstname" class="form-label">Firstname</label>
                <input type="text" class="form-control" id="firstname"
                    value="@Model.Friend.FirstName" readonly>
            </div>
            <div class="col-sm-6">
                <label for="lastname" class="form-label">Lastname</label>
                <input type="text" class="form-control" id="lastname"
                    value="@Model.Friend.LastName" readonly>
            </div>
            <div class="col-sm-6">
                <label for="friendBirthday" class="form-label">Birthday</label>
                <input type="text" class="form-control" id="friendBirthday"
                    value="@(Model.Friend.Birthday.HasValue ? Model.Friend.Birthday.Value.ToString("yyyy-MM-dd") : "Couldnt find any birthday")"
                    readonly>
            </div>
            <div class="col-sm-6">
                <label for="friendEmail" class="form-label">Email</label>
                <input type="text" class="form-control" id="friendEmail" value="@Model.Friend.Email" readonly>
            </div>
            <div class="col-sm-6">
                <label for="friendID" class="form-label">Friend ID</label>
                <input type="text" class="form-control" id="friendID" value="@Model.Friend.FriendId" readonly>
            </div>
            
            <h3 class="pb-2 border-bottom">Address</h3>
            @if (!Model.EditAddress && Model.Friend.Address != null)
            {
                <div class="col-sm-6">
                    <label asp-for="Friend.Address.StreetAddress" class="form-label"></label>
                    <input asp-for="Friend.Address.StreetAddress" class="form-control" readonly>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Friend.Address.City" class="form-label"></label>
                    <input asp-for="Friend.Address.City" class="form-control" readonly>
                </div>
                 <div class="col-sm-6">
                    <label asp-for="Friend.Address.ZipCode" class="form-label"></label>
                    <input asp-for="Friend.Address.ZipCode" class="form-control" readonly>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Friend.Address.Country" class="form-label"></label>
                    <input asp-for="Friend.Address.Country" class="form-control" readonly>
                </div>
                <div class="col-sm-12">
                    <a asp-page="./FriendDetails" 
                    asp-route-id="@Model.Friend.FriendId" 
                    asp-route-edit="true" 
                    class="btn btn-primary mt-3">Edit</a>
                </div>
            }
            @if (Model.EditAddress)
            {
                <form method="post" asp-page-handler="Edit"> 
                <div class="col-sm-6">
                    <label asp-for="AddressIM.StreetAddress" class="form-label"></label>
                    <input asp-for="AddressIM.StreetAddress" class="form-control">
                </div>
                <div class="col-sm-6">
                    <label asp-for="AddressIM.City" class="form-label"></label>
                    <input asp-for="AddressIM.City" class="form-control">
                </div>
                 <div class="col-sm-6">
                    <label asp-for="AddressIM.ZipCode" class="form-label"></label>
                    <input asp-for="AddressIM.ZipCode" class="form-control">
                </div>
                <div class="col-sm-6">
                    <label asp-for="AddressIM.Country" class="form-label"></label>
                    <input asp-for="AddressIM.Country" class="form-control">
                </div>
                <input type="hidden" asp-for="AddressIM.AddressId" />
                <input type="hidden" asp-for="AddressIM.FriendId" />
                <button type="submit" class="btn btn-success mt-3">Save</button>
                <a class="btn btn-secondary mt-3" 
                   asp-page="./FriendDetails" 
                   asp-route-id="@Model.Friend.FriendId">Cancel</a>
                
                </form>
            }

            @if (Model.Friend.Pets != null)
            {
                <h3 class="pb-2 border-bottom">Pets</h3>

                @foreach (var pet in Model.Friend.Pets)
                {
                    <div class="col-sm-6">
                        <label for="petName-@pet.PetId" class="form-label">Name</label>
                        <input type="text" class="form-control" id="petName-@pet.PetId" value="@pet.Name" readonly>
                    </div>

                    <div class="col-sm-6">
                        <label for="petKind-@pet.PetId" class="form-label">Kind</label>
                        <input type="text" class="form-control" id="petKind-@pet.PetId" value="@pet.Kind" readonly>
                    </div>
                    
                    <form method="post">
                        <input type="hidden" name="friendId" value="@Model.Friend.FriendId" />
                        <input type="hidden" name="petId" value="@pet.PetId" />
                        <button type="button" class="btn btn-success btn-sm m-1"
                            data-bs-toggle="modal" data-bs-target="#deleteModal@(pet.PetId)">Del</button>
                        
                        <div class="modal fade" id="deleteModal@(pet.PetId)" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title text-danger">Confirm deletion</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        You are about to delete @pet.Name. the @pet.Kind Are you sure?
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                                        <button type="submit" asp-page-handler="Delete" class="btn btn-danger">Yes</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                }
            }
            else
            {
                <div class="col-sm-12">
                    <p class="alert alert-info">This friend has no pets.</p>
                </div>
            }
            @if (Model.Friend.Quotes != null)
            {
                <h3 class="pb-2 border-bottom">Favorite quotes</h3>

                @foreach (var quote in Model.Friend.Quotes)
                {

                    <div class="col-sm-12">
                        <label for="quoteText" class="form-label">Quote</label>
                        <input type="text" class="form-control" id="quoteText" value="@quote.QuoteText By: @quote.Author" readonly>
                    </div>
                   
                }
            }
            else
            {
                <div class="col-sm-12">
                    <p class="alert alert-info">This friend has no quotes.</p>
                </div>
            }

        </div>

    </div>
</div>
}
else {
    <h4>FRIEND NOT FOUND </h4>
}