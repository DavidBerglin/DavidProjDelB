<div class="container px-4 py-5" id="list-of-items">

    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-primary mb-3">
            <svg class="bi bi-boombox" width="50" height="50"><use xlink:href="#person-fill" /></svg>
            Friends
        </h1>
        <p class="lead text-muted">List of all friends</p>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-gradient text-white py-3"
             style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold">
                    <svg class="bi me-2" width="1.5em" height="1.5em" fill="currentColor"><use xlink:href="#album" /></svg>
                    All friends
                </h4>

            
            </div>
        </div>

        <div class="card-body p-4">

            <!-- Search filter -->
            <form method="get" class="mb-4">
                <div class="row g-2 justify-content-center">
                    <div class="col-12 col-md-7 col-lg-6">
                        <div class="form-floating">
                            <input class="form-control" type="search" placeholder="Search for a city" name="searchString" />
                            <label>Search for a city/country</label>
                        </div>
                    </div>
                    <div class="col-12 col-md-3 col-lg-2 d-grid">
                        <button class="btn btn-outline-success" type="submit">
                            <svg class="bi me-2" width="1em" height="1em"><use xlink:href="#edit" /></svg>
                            Search
                        </button>
                    </div>
                </div>
            </form>

            <input type="hidden" name="groupId" data-seido-selected-item-id-target />
            <div class="d-grid gap-3">
                @foreach (var friend in Model.Friends)
                {
                    <div class="card shadow-sm border-0">
                        <div class="card-body bg-light">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    @friend.FirstName @friend.LastName
                                </h5>

                                <a asp-page="/Friends/FriendDetails" asp-route-id=@friend.FriendId
                                   class="btn btn-primary btn-sm" type="button">
                                    <svg class="bi me-1" width="0.9em" height="0.9em"><use xlink:href="#edit" /></svg>
                                    View
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <nav class="mt-4" aria-label="Standard pagination example">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item">
                        <a class="page-link" href="#list-of-items" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                    <li class="page-item"><a class="page-link" href="#list-of-items">1</a></li>
                    <li class="page-item"><a class="page-link" href="#list-of-items">2</a></li>
                    <li class="page-item"><a class="page-link" href="#list-of-items">3</a></li>
                    <li class="page-item">
                        <a class="page-link" href="#list-of-items" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>

        </div>
    </div>

    <div class="modal fade" id="delModal" tabindex="-1" aria-labelledby="softModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger" id="softModalLabel">Confirm deletion</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete this quote?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-danger">Ok</button>
                </div>
            </div>
        </div>
    </div>

</div>
