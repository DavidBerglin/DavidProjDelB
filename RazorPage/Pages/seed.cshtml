@page
@model SeedModel
@{
    ViewData["Title"] = "Page for seeding friends";
}
<h1>@ViewData["Title"]</h1>

        <div class="container px-4 py-4" id="seed">

          <p>Current the database contains 100 music groups. Reseed according to the number of items you want.
            You may optionally remove the old data before seeding.
          </p>

          <div class="row row-cols-1 row-cols-lg-4 align-items-stretch g-4 py-5">
              <div class="col-md-7 col-lg-8">
                  <form class="needs-validation" method="post" novalidate>
                      <div class="row g-3">
                          <div class="col-sm-6">
                              <label for="nrItems" class="form-label">Number of items</label>
                             <!--  <input asp-for="NrOfItems" type="text" class="form-control is-invalid" id="nrItems" placeholder="" value=""> -->
                              <div class="invalid-feedback">
                                  Must give number to seed
                              </div>
                              <label class="form-check-label" for="removeSeeds"></label>
                              <!-- <input asp-for="RemoveSeeds" class="form-check-input" type="checkbox" id="removeSeeds"> -->
                              Clear before seeding
                          </div>
                      </div>
                      <button class="w-100 btn btn-primary btn-lg my-4" type="submit">Seed</button>
                  </form>
              </div>
          </div>
        </div>
